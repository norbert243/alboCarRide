# Environment variables for AlboCarRide
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# ===================
# Supabase Configuration
# ===================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===================
# Google Maps & Places API
# ===================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACE_API_KEY=your_google_place_api_key_here
GOOGLE_DIRECTIONS_API_KEY=your_google_directions_api_key_here
GOOGLE_GEOLOCATION_API_KEY=your_google_geolocation_api_key_here

# ===================
# Firebase Configuration
# ===================
FIREBASE_PROJECT_ID=your_firebase_project_id

# ===================
# Twilio SMS Configuration
# ===================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGE_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================
# Payments (Stripe) - Optional
# ===================
# STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
